# Copy this file to ".env" and fill in your values.
# Find them in the Tuya developer platform: your project -> Overview -> Authorization Key

TUYA_ACCESS_ID=your_access_id
TUYA_ACCESS_SECRET=your_access_secret

# Central Europe data center (matches your project)
TUYA_BASE_URL=https://openapi.tuyaeu.com

# Local web server port (only reachable from this PC)
PORT=3000

# How often to poll Tuya for status, in seconds (minimum 10).
# Each poll is ~1 API call for all devices, so mind your plan's quota.
POLL_SECONDS=30

# Optional: comma-separated device IDs. Leave empty to list every device
# linked to your project through the Smart Life app account.
DEVICE_IDS=

# How many days of history to keep (charts are built from data/history.db)
HISTORY_DAYS=365
